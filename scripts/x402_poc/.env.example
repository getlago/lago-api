# x402 POC — copy to scripts/x402_poc/.env and fill in. Read only by the scripts in this folder.

# CDP Secret API Key: Ed25519 (base64), or an ECDSA PEM in double quotes with \n line breaks.
# setup.rb copies it onto the POC x402 connection; Lago uses it for /verify and /settle.
X402_POC_CDP_API_KEY_ID=
X402_POC_CDP_API_KEY_SECRET=

# Merchant payout address (EVM), any Base Sepolia address you control (D17's CDP-account check is out of POC scope).
X402_POC_PAYOUT_ADDRESS=

# The demo agent's private key (0x + 64 hex). Its address needs Base Sepolia USDC; no ETH (EIP-3009 is gasless for the payer).
X402_POC_BUYER_PRIVATE_KEY=

# Optional
X402_POC_NETWORK=eip155:84532
X402_POC_TOP_UP_CENTS=10
X402_POC_RPC_URL=https://sepolia.base.org
