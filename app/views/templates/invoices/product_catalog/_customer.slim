.body-1 = customer.display_name
- if customer.legal_number.present?
  .body-1 = customer.legal_number
== Addressing::DefaultFormatter.new.format( \
  Addressing::Address.new( \
    address_line1: customer.address_line1 || "",
    address_line2: customer.address_line2 || "",
    locality: customer.city || "",
    postal_code: customer.zipcode || "",
    administrative_area: customer.state || "",
    country_code: customer.country || "",
    locale: customer.document_locale \
  ),
  {locale: customer.document_locale || customer.billing_entity.document_locale, html_tag: "div", html_attributes: {class: "body-1"}} \
)
- if customer.email.present?
  .body-1 = customer.email.gsub(/,\s*/, ", ")
- if customer.tax_identification_number.present?
  .body-1 = I18n.t('invoice.tax_identification_number', tax_identification_number: customer.tax_identification_number)
