doctype html
html lang=I18n.locale
  head
    meta charset='UTF-8'
    title = document_invoice_name
    == SlimHelper.render('templates/invoices/product_catalog/_styles', self)
  body
    - catalog = ProductCatalogInvoiceHelper.new(self)
    .document.body-1
      == SlimHelper.render('templates/invoices/product_catalog/_header', self)
      == SlimHelper.render('templates/invoices/product_catalog/_summary', self, catalog:)
      == SlimHelper.render('templates/invoices/product_catalog/_notes', self)
      == SlimHelper.render('templates/invoices/product_catalog/_details_pages', self, catalog:)
