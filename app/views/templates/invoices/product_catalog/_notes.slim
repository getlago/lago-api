- if billing_entity.eu_tax_management.present? && applied_taxes.present?
  - applied_tax_codes = applied_taxes.pluck(:tax_code)
  p.document-section.body-2.color-muted
    - if applied_tax_codes.include?('lago_eu_tax_exempt')
      = billing_entity.country == 'FR' ? I18n.t('invoice.taxes.fr_tax_exempt') : I18n.t('invoice.taxes.tax_exempt')
    - if applied_tax_codes.include?('lago_eu_reverse_charge')
      = I18n.t('invoice.taxes.reverse_charge')

- if applied_invoice_custom_sections.present?
  .document-custom-sections.body-2.color-muted.document-section
    - applied_invoice_custom_sections.each do |section|
      .document-custom-section
        p.section-name.body-2-emphasis = section.display_name
        p.body-2.color-muted = LineBreakHelper.break_lines(section.details)

- footer = self_billed? ? I18n.t('invoice.self_billed.footer') : billing_entity.invoice_footer
- if footer.present?
  p.document-custom-footer.body-2.color-muted = LineBreakHelper.break_lines(footer)

== SlimHelper.render('templates/invoices/v4/_powered_by_logo', self)
