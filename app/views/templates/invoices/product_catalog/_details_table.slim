- rows = ProductCatalogInvoiceHelper.detail_rows(section, currency)
table class=['document-table', 'document-table--details', ('document-section' if spaced)]
  colgroup
    col.description-column
    col.quantity-column
    col.unit-price-column
    col.amount-column
  thead
    tr.row--header
      th.document-cell.cell--description.cell--header.body-3.indent-0.color-muted scope='col' = I18n.t('invoice.description')
      th.document-cell.cell--quantity.cell--header.body-3.color-muted scope='col' = I18n.t('invoice.quantity')
      th.document-cell.cell--unit-price.cell--header.body-3.color-muted scope='col' = I18n.t('invoice.unit_price')
      th.document-cell.cell--amount.cell--header.body-3.color-muted scope='col' = I18n.t('invoice.amount')
  tbody
    - rows.each_with_index do |row, index|
      - case row.kind
      - when :category, :product
        tr class="row--#{row.kind}"
          td.document-heading-cell class=["cell--#{row.kind}", 'body-2-emphasis'] colspan=4
            .document-heading class="indent-#{row.indent}"
              span.document-heading-label = row.label
              span.document-heading-amount.numeric = row.amount
      - when :filter
        tr.row--filter
          td.document-cell.cell--description.cell--filter.body-3-emphasis class="indent-#{row.indent}" colspan=4 = row.label
      - else
        - kind = row.kind.to_s.dasherize
        - muted = ('color-muted' unless row.kind == :segment)
        - at_end = ('cell--at-end' if index == rows.size - 1)
        tr class="row--#{kind}"
          td class=['document-cell', 'cell--description', "cell--#{kind}", 'body-3', "indent-#{row.indent}", muted, at_end] = row.label
          td class=['document-cell', 'cell--quantity', "cell--#{kind}", 'body-3', 'color-muted', at_end, 'numeric'] = row.units
          td class=['document-cell', 'cell--unit-price', "cell--#{kind}", 'body-3', 'color-muted', at_end, 'numeric'] = row.unit_price
          td class=['document-cell', 'cell--amount', "cell--#{kind}", 'body-3', 'color-muted', at_end, 'numeric'] = row.amount
