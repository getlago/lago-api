css:
  h1, h2, p { margin: 0; padding: 0; }
  html { font-family: Inter, sans-serif; }
  h1 { color: #1a1a1a; font-weight: 700; font-size: 24px; line-height: 32px; }
  .body-1 { color: #1a1a1a; font-weight: 600; font-size: 10px; line-height: 16px; }
  .body-2 { color: #1a1a1a; font-weight: 400; font-size: 10px; line-height: 16px; }
  .body-3 { color: #525252; font-weight: 400; font-size: 9px; line-height: 16px; }
  .mb-24 { margin-bottom: 20px; }
  .overflow-auto { overflow: auto; }
  .invoice-title { display: inline; }
  .header-logo { float: right; max-height: 32px; }
  .half { float: left; width: 50%; }
  .info-table { border-collapse: collapse; }
  .info-table td { padding: 0 12px 0 0; vertical-align: top; }
  table.lines, table.totals { width: 100%; border-collapse: collapse; }
  table.lines th { color: #525252; font-size: 8px; line-height: 12px; font-weight: 400; text-align: right; padding: 4px 4px 4px 12px; white-space: nowrap; }
  table.lines th:first-child { text-align: left; padding: 4px 12px 4px 4px; }
  table.lines tbody { border: 1px solid #d9dee7; }
  table.lines td { color: #1a1a1a; font-size: 9px; line-height: 16px; font-weight: 400; padding: 4px 4px 4px 12px; text-align: right; white-space: nowrap; }
  table.lines td:first-child { text-align: left; white-space: normal; width: 72%; padding: 4px 12px 4px 4px; }
  table.lines tr { break-inside: avoid; }
  tr.category td { background: #f1f3f5; font-weight: 600; border-bottom: 1px solid #d9dee7; }
  tr.product td { font-weight: 600; }
  tr.product td:first-child { padding-left: 8px; }
  tr.filter td { font-size: 8px; line-height: 12px; font-weight: 600; }
  tr.filter td:first-child { padding-left: 16px; }
  tr.period td, tr.filter-period td { font-size: 8px; line-height: 12px; color: #525252; }
  tr.period td:first-child, tr.filter-period td:first-child { color: #1a1a1a; }
  tr.period td:first-child { padding-left: 16px; }
  tr.filter-period td:first-child { padding-left: 24px; }
  tr.tier td { font-size: 8px; line-height: 12px; color: #525252; }
  tr.tier td:first-child { padding-left: 24px; }
  tr.filter-tier td:first-child { padding-left: 32px; }
  table.totals { width: 50%; margin-left: 50%; border: 1px solid #d9dee7; border-top: none; }
  table.totals td { color: #1a1a1a; font-size: 9px; line-height: 16px; font-weight: 400; padding: 4px 12px 4px 4px; }
  table.totals td:last-child { text-align: right; padding: 4px 4px 4px 12px; white-space: nowrap; }
  table.totals tr.total td { font-weight: 600; border-bottom: 1px solid #d9dee7; }
  .details-page { page-break-before: always; }
  .details-page > .mb-24 p.body-3 { font-size: 10px; line-height: 16px; margin-top: 2px; }
  .invoice-custom-section { margin-top: 0; padding: 20px 0; border-bottom: 1px solid #d9dee7; }
  .invoice-custom-section p.section-name { font-size: 9px; margin-bottom: 4px; }
  .invoice-custom-section p.mb-24 { margin-bottom: 0; }
  .wrapper > p.body-3 { padding: 20px 0; margin-bottom: 0; }
  .powered-by { width: 100%; text-align: right; }
  .powered-by span { color: #525252; font-size: 10px; }
  .powered-by img { width: 37px; height: 11px; vertical-align: middle; margin-top: 2px; }
