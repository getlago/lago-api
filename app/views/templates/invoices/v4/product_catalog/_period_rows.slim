- fees.each do |fee|
  tr class=(nested ? 'filter-period' : 'period')
    td.body-2 = ProductCatalogInvoiceHelper.period_label(fee)
    td.body-2 = RoundingHelper.round_decimal_part(fee.units)
    td.body-2 = FeeDisplayHelper.format_precise_unit_amount(fee)
    td.body-2 = FeeDisplayHelper.format_amount(fee)
  - ProductCatalogInvoiceHelper.tiers(fee).each do |tier|
    tr class=(nested ? 'tier filter-tier' : 'tier')
      td.body-2 = tier.label
      td.body-2 = tier.units
      td.body-2 = tier.unit_price
      td.body-2 = tier.amount
