- ProductCatalogInvoiceHelper.contract_blocks(self).each do |block|
  h2.title-2.invoice-details-title = I18n.t('invoice.details_title')
  .body-1.mb-24 = block.title

  - block.sections.each do |section|
    .invoice-resume.mb-24.overflow-auto
      table.invoice-resume-table width="100%"
        tr.first_child
          td.body-2 = I18n.t('invoice.description')
          td.body-2 = I18n.t('invoice.quantity')
          td.body-2 = I18n.t('invoice.unit_price')
          td.body-2 = I18n.t('invoice.amount')
        - ProductCatalogInvoiceHelper.detail_rows(section, currency).each do |row|
          - indent = "padding-left: #{row.indent * 12}px"
          - case row.kind
          - when :category, :product
            tr.charge-name
              td.body-1 style=indent = row.label
              td
              td
              td.body-1 = row.amount
          - when :filter
            tr.charge-name
              td.body-2 style=indent colspan=4 = row.label
          - when :segment
            tr
              td.body-2 style=indent = row.label
              td.body-2 = row.units
              td.body-2 = row.unit_price
              td.body-2 = row.amount
          - else
            tr.details
              td.body-3 style=indent = row.label
              td.body-3 = row.units
              td.body-3 = row.unit_price
              td.body-3 = row.amount
