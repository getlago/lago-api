- recurring_fees = ProductCatalogReceiptHelper.recurring_fees(fees)

- if recurring_fees.any?
  .invoice-resume.mb-24.overflow-auto
    - recurring_fees.each do |product_fees|
      h2.invoice-details-title.title-2.mb-24 = I18n.t('invoice.details', resource: ProductCatalogInvoiceHelper.contract_name(contract))

      / One breakdown per product filter when every fee bills one, as v1 does per charge filter
      - by_filter = product_fees.all?(&:product_filter_id?)
      - sections = by_filter ? product_fees.select { it.units.positive? }.map { [it] } : [product_fees]
      - breakdowns = []

      - sections.each do |section_fees|
        .body-3 = product_fees.first.invoice_name
        - if by_filter
          .body-1.mb-24 = I18n.t('invoice.breakdown_of', fee_filter_display_name: section_fees.first.filter_display_name)
        - else
          .body-1.mb-24 = I18n.t('invoice.breakdown')
        .breakdown-details.mb-24
          table.breakdown-details-table width="100%"
            - section_fees.each do |fee|
              - ProductCatalogReceiptHelper.recurring_breakdown(fee).each do |breakdown|
                - breakdowns << breakdown
                tr
                  td width="20%"
                    .body-1 = I18n.l(breakdown.date, format: :default)
                    .body-3 = I18n.t('invoice.breakdown_for_days', breakdown_duration: breakdown.duration, breakdown_total_duration: breakdown.total_duration)
                  td.body-1 width="80%"
                    - if breakdown.action.to_sym == :add
                      | +#{breakdown.amount} #{fee.item_name}
                    - elsif breakdown.action.to_sym == :remove
                      | #{breakdown.amount.negative? ? '' : '-'}#{breakdown.amount} #{fee.item_name}
                    - else
                      | +/-#{breakdown.amount} #{fee.item_name}

      - if product_fees.first.contract_rate_card.rate_card.proration?
        .alert.body-3 = I18n.t('invoice.notice_prorated', days_in_month: breakdowns.last&.total_duration || 30)
      - else
        .alert.body-3 = I18n.t('invoice.notice_full')
